{
  "name": "shader-generator",
  "version": "1.0.0",
  "description": "A library to generate GLSL shaders for WebGL with JS/TS",
  "license": "ISC",
  "author": "erfan114",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "tsup": "^8.5.1",
    "typescript": "5.9",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
