{
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-sort-re-exports"
  ],
  "tabWidth": 2,
  "useTabs": false,
  "importOrder": [
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "^[@/]",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
